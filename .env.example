# ==== Kuyay Natural - Variables de entorno ====
# Copia este archivo a ".env.local" (desarrollo) y configuralas en Vercel.

# --- PostgreSQL (Neon) ---
# Neon Dashboard > Connection Details > Connection string (pooled)
DATABASE_URL=postgresql://usuario:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Better Auth ---
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=reemplaza-con-un-secreto-largo
# URL publica del sitio (en produccion: https://tu-dominio.vercel.app)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Vercel Blob (subida de imagenes) ---
# Vercel Dashboard > Storage > Blob > token de lectura/escritura
BLOB_READ_WRITE_TOKEN=

# --- WhatsApp de la tienda (solo digitos, con codigo de pais) ---
NEXT_PUBLIC_WHATSAPP_PRIMARY=593991028834
NEXT_PUBLIC_WHATSAPP_SECONDARY=593994395266

# --- Admin inicial (se crea con "npm run db:seed") ---
ADMIN_EMAIL=admin@kuyaynatural.com
ADMIN_PASSWORD=kuyay2026
ADMIN_NAME=Administrador Kuyay

# --- Datos bancarios para transferencias ---
NEXT_PUBLIC_BANK_NAME=Banco Pichincha
NEXT_PUBLIC_BANK_TYPE=Cuenta de Ahorros
NEXT_PUBLIC_BANK_ACCOUNT=2200000000
NEXT_PUBLIC_BANK_HOLDER=Kuyay Natural
NEXT_PUBLIC_BANK_ID=1790000000001
